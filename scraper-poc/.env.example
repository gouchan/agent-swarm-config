# Copy this file to .env and fill in values as needed.

# Port for the local dev server (default: 3000)
PORT=3000

# ScraperAPI key — only needed if you check "Use ScraperAPI" in the UI.
# Sign up at https://www.scraperapi.com (free tier: 1,000 req/month).
# Without this key the scraper falls back to direct HTTP fetch (works for most
# static / server-rendered sites).
SCRAPERAPI_KEY=your_key_here
