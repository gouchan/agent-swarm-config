e, overwrite_output=True)            except ffmpeg.Error as e:                print(f"ffmpeg-python error: {e}")                self._reassemble_subprocess(frame_pattern, temp_video, fps)        else:            self._reassemble_subprocess(frame_pattern, temp_video, fps)                # Now add original audio back        self._add_audio(temp_video, original_video, output_path)                print(f"Video saved to: {output_path}")        def _reassemble_subprocess(self, frame_pattern: str, output_path: str, fps: float):        """Fallback video assembly using subprocess."""        cmd = [            "ffmpeg", "-framerate", str(fps), "-i", frame_pattern,            "-c:v", "libx264", "-pix_fmt", "yuv420p", "-crf", "18",            "-y", output_path        ]        subprocess.run(cmd, check=True, capture_output=True)        def _add_audio(self, video_path: str, audio_source: str, output_path: str):        """Add audio from original video to processed video."""        cmd = [            "ffmpeg", "-i", video_path, "-i", audio_source,            "-c:v", "copy", "-c:a", "aac", "-map", "0:v:0", "-map", "1:a:0",            "-shortest", "-y", output_path        ]        subprocess.run(cmd, check=True, capture_output=True)        def process(self, input_path: str, output_path: str):        """Run the complete pipeline."""        try:            # Setup            self.create_temp_directories()                        # Step 1: Extract frames            frames, metadata = self.extract_frames(input_path)            if not frames:                raise RuntimeError("No frames extracted")                        # Step 2: Detect watermark region            bbox = self.detect_watermark_region(frames[0])            print(f"Watermark region: {bbox}")                        # Step 3: Inpaint frames            inpainted_frames = self.process_frames(frames, bbox)                        # Step 4: Reassemble video            self.reassemble